# Path to the published data version (pipeline output, API input)
SENDA_DATA=./data/current

# NASA FIRMS map key, needed to download the current year
# https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# Yearly FIRMS country archives and boundary sources (downloaded zip files)
SENDA_ZIPS=
SENDA_GEO=

# Optional: Copernicus CDS key for `senda-pipeline climate` (ERA5 monthly means)
COPERNICUS_API_KEY=

# Optional: Google Maps key, the fallback for the way to a fire when OpenStreetMap has no answer
GOOGLE_MAPS_API_KEY=

# Claude API key for the in-app assistant; without it the assistant answers that it is unavailable
ANTHROPIC_API_KEY=

# Postgres of the chats and saved plans: `docker compose up -d`, then `make migrate` in api/
SENDA_DB_PASSWORD=
DATABASE_URL=postgresql+psycopg://senda:<password>@127.0.0.1:5437/senda
